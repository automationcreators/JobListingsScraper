# Placeholder environment file for JobListingsScraper.
# Copy to .env only if you add an integration later.
# The servers in this repo do not load .env today.
# No API keys are required for the local CSV demo.
# Never commit a filled-in .env. Never put real keys in this file.

# Reserved names. Not read by batch_server.py, enhanced_server.py,
# simple_server.py, or run_mvp.py.
HOST=127.0.0.1
PORT=8000
DEFAULT_BATCH_SIZE=50
MAX_BATCH_SIZE=1000

# Declared in requirements.txt, not called by application code.
# Keep these as placeholders. Use example.com for any callback URL.
GOOGLE_API_KEY=REDACTED
GOOGLE_SHEETS_SPREADSHEET_ID=REDACTED
AIRTABLE_API_KEY=REDACTED
AIRTABLE_BASE_ID=appEXAMPLE
OPENAI_API_KEY=REDACTED
ANTHROPIC_API_KEY=REDACTED
